 	depends on KSU
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 2c0aeab2..1149f5dc 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -23,6 +23,18 @@ static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const st
 
 	// Handle kernel umount
 	ksu_handle_umount(new, old);
+
+#ifdef CONFIG_KSU_SUSFS
+	/* Mark only zygote-spawned processes that KernelSU would unmount. */
+	if (is_zygote(old) &&
+		(is_appuid(new_uid) || is_isolated_process(new_uid)) &&
+		(ksu_uid_should_umount(new_uid) || is_isolated_process(new_uid))) {
+		extern struct work_struct susfs_extra_works;
+
+		schedule_work(&susfs_extra_works);
+		susfs_set_current_proc_umounted();
+	}
+#endif
 	return;
 
