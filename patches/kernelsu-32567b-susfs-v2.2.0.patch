diff --git a/kernel/Kconfig b/kernel/Kconfig
index c18ac59f..d38085c3 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -90,6 +90,79 @@ config KSU_LSM_SECURITY_HOOKS
 	  Disabling this is mostly useful for non-ARM64 with kernel > 6.8.
 	  Make sure to implement manual hooks on security/security.c.
 
+menu "KernelSU - SUSFS"
+
+config KSU_SUSFS
+	bool "KernelSU addon - SUSFS"
+	depends on KSU
+	depends on THREAD_INFO_IN_TASK
+	default n
+	help
+	  Enable the SUSFS kernel driver and its KernelSU command bridge.
+
+config KSU_SUSFS_SUS_PATH
+	bool "Hide suspicious paths"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "Hide suspicious mounts"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "Spoof suspicious kstat data"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_TRY_UMOUNT
+	bool "Use SUSFS user-defined try_umount paths"
+	depends on KSU_SUSFS
+	default n
+	help
+	  SUSFS v2.2.0 deprecates this command. Keep it disabled and use
+	  KernelSU's built-in unmount list unless a matching driver is added.
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "Spoof uname"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "Enable SUSFS kernel logging"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "Hide KernelSU and SUSFS symbols from /proc/kallsyms"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "Spoof /proc/cmdline or /proc/bootconfig"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "Redirect selected opened paths"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_MAP
+	bool "Hide selected file-backed memory maps"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_MEMFD
+	bool "Hide suspicious memfd names"
+	depends on KSU_SUSFS
+	default n
+	help
+	  Disabled for the v2.2.0 non-GKI driver because that driver does not
+	  define the matching userspace command.
+
+endmenu
+
 config KSU_HEURISTIC_IN_TREE_BUILD
